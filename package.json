{
  "name": "volumute",
  "version": "0.2.0",
  "description": "VoluMute - site-based auto mute and per-page/per-site volume control",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "node scripts/build.js",
    "build:chrome": "node scripts/build.js chrome",
    "build:firefox": "node scripts/build.js firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write \"src/**/*.{svelte,ts,js}\""
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/webextension-polyfill": "^0.12.5",
    "archiver": "^7.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^4.1.10",
    "web-ext": "^10.6.0",
    "webextension-polyfill": "^0.12.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0"
  }
}
